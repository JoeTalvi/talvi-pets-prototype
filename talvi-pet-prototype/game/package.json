{
  "name": "talvi-pet-prototype",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.17.1",
    "npm": "10.9.2"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests tools",
    "check:content": "tsx tools/check-content.ts",
    "check:assets": "tsx tools/check-assets.ts",
    "report:coverage": "tsx tools/coverage.ts",
    "preview:feed": "tsx tools/feed-preview.ts",
    "preview:pet": "tsx tools/pet-preview.ts",
    "log": "tsx tools/log-reader.ts",
    "fixture": "tsx tools/make-fixture.ts",
    "deploy": "npm run build && wrangler deploy",
    "asset:ledger": "tsx tools/asset-ledger.ts"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/baloo-2": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
